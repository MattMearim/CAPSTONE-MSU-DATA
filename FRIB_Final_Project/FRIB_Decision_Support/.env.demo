# Fictional-data demonstration with real local generation and semantic search.
# Run SETUP_LOCAL_AI.command before starting the application.
FRIB_CONFIG_DIR=config
FRIB_DATA_DIR=data-local-ai
FRIB_LLM_PROVIDER=ollama
FRIB_LLM_MODEL=qwen3:8b
FRIB_EMBEDDING_PROVIDER=sentence_transformers
FRIB_EMBEDDING_MODEL=all-MiniLM-L6-v2
FRIB_VECTOR_PROVIDER=sqlite
