{
  "$defs": {
    "LogEntry": {
      "properties": {
        "timestamp_s": {
          "title": "Timestamp S",
          "type": "number"
        },
        "level": {
          "default": "INFO",
          "title": "Level",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "source": {
          "default": "synthetic",
          "title": "Source",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "timestamp_s",
        "message"
      ],
      "title": "LogEntry",
      "type": "object"
    },
    "Provenance": {
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "generator_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator Version"
        },
        "imported_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Imported By"
        },
        "checksum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "source"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Signal": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        },
        "sample_rate_hz": {
          "exclusiveMinimum": 0,
          "title": "Sample Rate Hz",
          "type": "number"
        },
        "timestamps_s": {
          "items": {
            "type": "number"
          },
          "maxItems": 250000,
          "title": "Timestamps S",
          "type": "array"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "maxItems": 250000,
          "title": "Values",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "name",
        "sample_rate_hz",
        "timestamps_s",
        "values"
      ],
      "title": "Signal",
      "type": "object"
    },
    "StateEvent": {
      "properties": {
        "timestamp_s": {
          "title": "Timestamp S",
          "type": "number"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "timestamp_s",
        "name",
        "value"
      ],
      "title": "StateEvent",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Event Id",
      "type": "string"
    },
    "domain": {
      "title": "Domain",
      "type": "string"
    },
    "event_type": {
      "title": "Event Type",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "signals": {
      "items": {
        "$ref": "#/$defs/Signal"
      },
      "maxItems": 64,
      "title": "Signals",
      "type": "array"
    },
    "states": {
      "items": {
        "$ref": "#/$defs/StateEvent"
      },
      "maxItems": 250000,
      "title": "States",
      "type": "array"
    },
    "logs": {
      "items": {
        "$ref": "#/$defs/LogEntry"
      },
      "maxItems": 250000,
      "title": "Logs",
      "type": "array"
    },
    "attachments": {
      "items": {
        "type": "string"
      },
      "title": "Attachments",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "event_id",
    "domain",
    "event_type",
    "provenance"
  ],
  "title": "EngineeringEvent",
  "type": "object"
}