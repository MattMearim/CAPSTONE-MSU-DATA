{
  "domain": "plc",
  "description": "Fictional cooling-water interlock rack. Shapes and numbers are illustrative.",
  "instrument": "simulated PLC historian",
  "assets": [
    {"id": "PLC-A1", "subsystem": "cooling interlock rack", "location": "Control room rack A"},
    {"id": "PLC-B2", "subsystem": "cooling interlock rack", "location": "Control room rack B"}
  ],
  "operating_modes": ["operating", "operating", "maintenance"],
  "configuration": {
    "flow_warn_lpm": 32.0,
    "flow_trip_lpm": 25.0,
    "scan_time_ms": {"choice": [10, 20]}
  },
  "window": {"duration_s": 60.0, "pre_fault_s": 30.0},
  "imperfections": {"gap_probability": 0.04, "gap_max_fraction": 0.01},
  "channels": [
    {"name": "supply_flow", "unit": "L/min", "quantity": "flow", "sample_rate_hz": 10, "min": 0,
     "baseline": [{"type": "constant", "value": {"min": 39.5, "max": 40.5}}, {"type": "noise", "sigma": 0.2}]},
    {"name": "supply_temperature", "unit": "degC", "quantity": "temperature", "sample_rate_hz": 10,
     "baseline": [{"type": "constant", "value": {"min": 19, "max": 21}},
                  {"type": "sine", "amp": 0.2, "freq_hz": 0.02}, {"type": "noise", "sigma": 0.03}]},
    {"name": "valve_position", "unit": "%", "quantity": "position", "sample_rate_hz": 10, "min": 0, "max": 100,
     "baseline": [{"type": "constant", "value": {"min": 55, "max": 65}}, {"type": "noise", "sigma": 0.1}]},
    {"name": "loop_pressure", "unit": "bar", "quantity": "pressure", "sample_rate_hz": 10, "min": 0,
     "baseline": [{"type": "constant", "value": {"min": 3.8, "max": 4.2}}, {"type": "noise", "sigma": 0.01}]},
    {"name": "permit_state", "unit": "1", "quantity": "discrete state (1 = granted)", "sample_rate_hz": 10, "min": 0, "max": 1,
     "baseline": [{"type": "constant", "value": 1}]}
  ],
  "scenarios": [
    {"id": "normal", "label": "normal", "weight": 2, "description": "Routine capture, no fault"},

    {"id": "low_flow_interlock", "label": "low_flow", "weight": 2,
     "description": "Flow falls over ten seconds, the valve opens to compensate, and the low-flow interlock removes the permit",
     "effects": [
       {"channel": "supply_flow", "type": "ramp", "slope_per_s": {"min": -1.6, "max": -1.45}, "delay_s": -10, "duration_s": 14},
       {"channel": "valve_position", "type": "ramp", "slope_per_s": {"min": 2.5, "max": 3.5}, "delay_s": -8, "duration_s": 10},
       {"channel": "loop_pressure", "type": "ramp", "slope_per_s": -0.05, "delay_s": -10, "duration_s": 14},
       {"channel": "permit_state", "type": "step", "delta": -1, "delay_s": 0.2}
     ],
     "events": [
       {"offset_s": -5.0, "jitter_s": 0.4, "name": "FLOW_LOW_WARN", "state_from": false, "state_to": true, "severity": "warning", "message": "Supply flow below warning limit"},
       {"offset_s": 0.0, "jitter_s": 0.2, "name": "FLOW_LOW_LOW", "state_from": false, "state_to": true, "severity": "alarm", "message": "Supply flow below trip limit"},
       {"offset_s": 0.2, "name": "COOLING_PERMIT", "state_from": true, "state_to": false, "severity": "trip", "message": "Cooling permit removed: low flow"},
       {"offset_s": 0.25, "name": "DOWNSTREAM_PERMIT", "state_from": true, "state_to": false, "severity": "trip", "message": "Downstream permit removed: cooling permit lost"}
     ],
     "documents": ["doc-pl-op-030-b", "doc-pl-op-032-a"]},

    {"id": "stale_sensor", "label": "sensor_frozen", "weight": 1,
     "description": "A temperature reading freezes at one value; nothing trips and the only clue is the flat line",
     "effects": [
       {"channel": "supply_temperature", "type": "freeze", "delay_s": -20, "duration_s": 45}
     ],
     "events": [
       {"offset_s": 5.0, "jitter_s": 1.0, "name": "TEMP_SIGNAL_STALE", "state_from": false, "state_to": true, "severity": "warning", "message": "Supply temperature unchanged beyond stale-signal timer"}
     ],
     "documents": ["doc-pl-ts-031-a"]},

    {"id": "comms_dropout", "label": "comms_loss", "weight": 1,
     "description": "Every analog reading from the rack goes missing for a few seconds; the process itself is fine",
     "effects": [
       {"channel": ["supply_flow", "supply_temperature", "valve_position", "loop_pressure", "permit_state"], "type": "dropout", "duration_s": 5.0}
     ],
     "events": [
       {"offset_s": 0.0, "name": "COMM_LINK", "state_from": "UP", "state_to": "DOWN", "severity": "alarm", "message": "Remote I/O link lost"},
       {"offset_s": 5.0, "name": "COMM_LINK", "state_from": "DOWN", "state_to": "UP", "severity": "info", "message": "Remote I/O link restored"}
     ],
     "documents": ["doc-pl-ts-031-a"]},

    {"id": "chattering_switch", "label": "false_trip_chattering_switch", "weight": 1,
     "description": "A flow switch input toggles rapidly and trips the permit while the measured flow stays normal",
     "effects": [
       {"channel": "permit_state", "type": "step", "delta": -1, "delay_s": 2.1}
     ],
     "events": [
       {"offset_s": 0.0, "name": "FLOW_SWITCH", "state_from": true, "state_to": false, "severity": "warning"},
       {"offset_s": 0.15, "name": "FLOW_SWITCH", "state_from": false, "state_to": true, "severity": "info"},
       {"offset_s": 0.4, "name": "FLOW_SWITCH", "state_from": true, "state_to": false, "severity": "warning"},
       {"offset_s": 0.5, "name": "FLOW_SWITCH", "state_from": false, "state_to": true, "severity": "info"},
       {"offset_s": 0.9, "name": "FLOW_SWITCH", "state_from": true, "state_to": false, "severity": "warning"},
       {"offset_s": 1.0, "name": "FLOW_SWITCH", "state_from": false, "state_to": true, "severity": "info"},
       {"offset_s": 1.6, "name": "FLOW_SWITCH", "state_from": true, "state_to": false, "severity": "warning"},
       {"offset_s": 2.1, "name": "COOLING_PERMIT", "state_from": true, "state_to": false, "severity": "trip", "message": "Cooling permit removed: flow switch open"}
     ],
     "documents": ["doc-pl-ts-031-a", "doc-pl-op-032-a"]}
  ]
}
