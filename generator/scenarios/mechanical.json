{
  "domain": "mechanical",
  "description": "Fictional cooling-water pump skid. Shapes and numbers are illustrative.",
  "instrument": "simulated vibration monitor",
  "assets": [
    {"id": "PUMP-01", "subsystem": "cooling skid", "location": "Utility room A"},
    {"id": "PUMP-02", "subsystem": "cooling skid", "location": "Utility room A"},
    {"id": "PUMP-03", "subsystem": "cooling skid", "location": "Utility room B"}
  ],
  "operating_modes": ["operating"],
  "configuration": {
    "shaft_speed_hz": {"choice": [29.5, 49.2, 59.0]},
    "flow_setpoint_lpm": {"min": 80.0, "max": 120.0}
  },
  "window": {"duration_s": 2.0, "pre_fault_s": 1.0},
  "imperfections": {"gap_probability": 0.06, "gap_max_fraction": 0.01},
  "channels": [
    {"name": "vibration_x", "unit": "mm/s", "quantity": "vibration velocity", "sample_rate_hz": 2000,
     "baseline": [{"type": "sine", "amp": {"min": 0.4, "max": 0.8}, "freq_hz": {"ref": "shaft_speed_hz"}},
                  {"type": "sine", "amp": 0.15, "freq_hz": {"ref": "shaft_speed_hz", "scale": 2}},
                  {"type": "noise", "sigma": 0.08}]},
    {"name": "vibration_y", "unit": "mm/s", "quantity": "vibration velocity", "sample_rate_hz": 2000,
     "baseline": [{"type": "sine", "amp": {"min": 0.4, "max": 0.8}, "freq_hz": {"ref": "shaft_speed_hz"}},
                  {"type": "sine", "amp": 0.15, "freq_hz": {"ref": "shaft_speed_hz", "scale": 2}},
                  {"type": "noise", "sigma": 0.08}]},
    {"name": "bearing_temperature", "unit": "degC", "quantity": "temperature", "sample_rate_hz": 50,
     "baseline": [{"type": "constant", "value": {"min": 49, "max": 51}}, {"type": "noise", "sigma": 0.05}]},
    {"name": "flow_rate", "unit": "L/min", "quantity": "flow", "sample_rate_hz": 50, "min": 0,
     "baseline": [{"type": "constant", "value": {"ref": "flow_setpoint_lpm"}}, {"type": "noise", "sigma": 0.5}]},
    {"name": "motor_current", "unit": "A", "quantity": "current", "sample_rate_hz": 50, "min": 0,
     "baseline": [{"type": "constant", "value": {"min": 11, "max": 13}}, {"type": "noise", "sigma": 0.05}]}
  ],
  "scenarios": [
    {"id": "normal", "label": "normal", "weight": 2, "description": "Routine capture, no fault"},

    {"id": "rotor_imbalance", "label": "rotor_imbalance", "weight": 2,
     "description": "Vibration at shaft speed jumps and stays high; pump keeps running",
     "effects": [
       {"channel": ["vibration_x", "vibration_y"], "type": "oscillation", "amp": {"min": 2.5, "max": 4.5}, "freq_hz": {"ref": "shaft_speed_hz"}}
     ],
     "events": [
       {"offset_s": 0.3, "jitter_s": 0.05, "name": "VIBRATION_HIGH", "state_from": false, "state_to": true, "severity": "warning", "message": "Vibration above warning limit"}
     ],
     "documents": ["doc-me-op-020-b"]},

    {"id": "bearing_defect", "label": "bearing_defect", "weight": 2,
     "description": "Non-synchronous vibration grows, bearing temperature climbs, pump trips on temperature",
     "effects": [
       {"channel": ["vibration_x", "vibration_y"], "type": "oscillation", "amp": {"min": 0.8, "max": 1.4}, "freq_hz": {"ref": "shaft_speed_hz", "scale": 3.57}, "growth_per_s": {"min": 0.8, "max": 1.4}, "delay_s": -1.0},
       {"channel": ["vibration_x", "vibration_y"], "type": "noise_burst", "sigma": 0.4, "delay_s": -1.0},
       {"channel": "bearing_temperature", "type": "step", "delta": {"min": 23, "max": 25}, "delay_s": -1.0},
       {"channel": "bearing_temperature", "type": "ramp", "slope_per_s": {"min": 6.0, "max": 7.0}, "delay_s": -1.0, "duration_s": 1.4},
       {"channel": ["vibration_x", "vibration_y"], "type": "exp_decay", "tau_s": 0.25, "target_fraction": 0.03, "delay_s": 0.4},
       {"channel": "flow_rate", "type": "exp_decay", "tau_s": 0.3, "delay_s": 0.4},
       {"channel": "motor_current", "type": "exp_decay", "tau_s": 0.02, "delay_s": 0.4}
     ],
     "events": [
       {"offset_s": -0.6, "jitter_s": 0.1, "name": "BEARING_TEMP_HIGH", "state_from": false, "state_to": true, "severity": "alarm", "message": "Bearing temperature above alarm limit"},
       {"offset_s": 0.4, "name": "PUMP_STATE", "state_from": "RUNNING", "state_to": "TRIPPED", "severity": "trip", "message": "Pump tripped: bearing temperature high-high"},
       {"offset_s": 0.9, "jitter_s": 0.05, "name": "FLOW_LOW", "state_from": false, "state_to": true, "severity": "alarm"}
     ],
     "documents": ["doc-me-ma-021-a", "doc-me-op-020-b"]},

    {"id": "cavitation", "label": "cavitation", "weight": 1,
     "description": "Broadband vibration with a drop in flow and motor current; pump keeps running",
     "effects": [
       {"channel": ["vibration_x", "vibration_y"], "type": "noise_burst", "sigma": {"min": 1.5, "max": 2.5}},
       {"channel": "flow_rate", "type": "step", "delta": {"min": -30, "max": -15}},
       {"channel": "flow_rate", "type": "noise_burst", "sigma": 3},
       {"channel": "motor_current", "type": "step", "delta": {"min": -1.5, "max": -0.8}}
     ],
     "events": [
       {"offset_s": 0.2, "jitter_s": 0.05, "name": "FLOW_LOW", "state_from": false, "state_to": true, "severity": "warning"},
       {"offset_s": 0.5, "jitter_s": 0.05, "name": "SUCTION_PRESSURE_LOW", "state_from": false, "state_to": true, "severity": "alarm", "message": "Suction pressure below limit"}
     ],
     "documents": ["doc-me-op-022-a", "doc-me-op-020-b"]}
  ]
}
