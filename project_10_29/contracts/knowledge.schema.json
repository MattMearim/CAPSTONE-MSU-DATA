{
  "$defs": {
    "Hypothesis": {
      "properties": {
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "support": {
          "default": "unknown",
          "title": "Support",
          "type": "string"
        },
        "supporting_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence",
          "type": "array"
        },
        "contradicting_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Contradicting Evidence",
          "type": "array"
        }
      },
      "required": [
        "rank",
        "description"
      ],
      "title": "Hypothesis",
      "type": "object"
    }
  },
  "properties": {
    "draft_id": {
      "title": "Draft Id",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "observations": {
      "items": {
        "type": "string"
      },
      "title": "Observations",
      "type": "array"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/Hypothesis"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "recommended_actions": {
      "items": {
        "type": "string"
      },
      "title": "Recommended Actions",
      "type": "array"
    },
    "affected_hardware": {
      "items": {
        "type": "string"
      },
      "title": "Affected Hardware",
      "type": "array"
    },
    "relevant_sources": {
      "items": {
        "type": "string"
      },
      "title": "Relevant Sources",
      "type": "array"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "status": {
      "default": "draft",
      "title": "Status",
      "type": "string"
    },
    "generated_by": {
      "default": "deterministic_fallback",
      "title": "Generated By",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_snapshot": {
      "additionalProperties": true,
      "title": "Evidence Snapshot",
      "type": "object"
    }
  },
  "required": [
    "draft_id",
    "event_id",
    "summary"
  ],
  "title": "KnowledgeDraft",
  "type": "object"
}