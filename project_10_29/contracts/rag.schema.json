{
  "$defs": {
    "RAGSource": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "label",
        "title",
        "document_id",
        "chunk_id"
      ],
      "title": "RAGSource",
      "type": "object"
    }
  },
  "properties": {
    "question": {
      "title": "Question",
      "type": "string"
    },
    "answer": {
      "title": "Answer",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/RAGSource"
      },
      "title": "Sources",
      "type": "array"
    },
    "grounded": {
      "default": false,
      "title": "Grounded",
      "type": "boolean"
    },
    "event_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Event Id"
    },
    "mode": {
      "default": "insufficient_context",
      "title": "Mode",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "interpretation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Interpretation"
    }
  },
  "required": [
    "question",
    "answer"
  ],
  "title": "RAGResponse",
  "type": "object"
}