FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
ARG FRIB_PACKAGE=.
RUN pip install --no-cache-dir -e "$FRIB_PACKAGE"
COPY config ./config
COPY prompts ./prompts
COPY sample_docs ./sample_docs
RUN mkdir -p data/events data/chroma
CMD ["uvicorn", "frib_ds.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
