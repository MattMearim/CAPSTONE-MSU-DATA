{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document.schema.json",
  "title": "Procedural document record",
  "description": "A procedure, manual or other reference text, split into sections so the Level 3 engine can cite the exact passage.",
  "type": "object",
  "required": ["schema_version", "record_type", "record_id", "provenance", "title", "doc_type", "revision", "status", "sections"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "record_type": { "const": "document" },
    "record_id": { "type": "string" },
    "provenance": { "$ref": "provenance.schema.json" },
    "title": { "type": "string" },
    "doc_type": { "type": "string", "description": "Free text, e.g. procedure, manual, checklist." },
    "revision": { "type": "string" },
    "status": { "enum": ["draft", "current", "superseded"] },
    "effective_date": { "type": "string", "format": "date" },
    "superseded_by": { "type": "string", "description": "record_id of the replacing document." },
    "applies_to": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Asset ids or subsystem names this document covers."
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["section_id", "text"],
        "additionalProperties": false,
        "properties": {
          "section_id": { "type": "string" },
          "heading": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    }
  }
}
