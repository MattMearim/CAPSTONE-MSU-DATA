{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event_log.schema.json",
  "title": "Discrete state / event log record",
  "description": "An ordered list of discrete state changes, alarms, interlocks or operator actions.",
  "type": "object",
  "required": ["schema_version", "record_type", "record_id", "provenance", "events"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "record_type": { "const": "event_log" },
    "record_id": { "type": "string" },
    "event_id": { "type": "string", "description": "Optional link to the operational event this log belongs to." },
    "provenance": { "$ref": "provenance.schema.json" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["timestamp", "name", "state_to"],
        "additionalProperties": false,
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "name": { "type": "string", "description": "Signal, tag or alarm name." },
          "state_from": { "type": ["string", "number", "boolean", "null"] },
          "state_to": { "type": ["string", "number", "boolean"] },
          "severity": { "enum": ["info", "warning", "alarm", "trip"] },
          "message": { "type": "string" },
          "attributes": { "type": "object", "additionalProperties": true }
        }
      }
    }
  }
}
